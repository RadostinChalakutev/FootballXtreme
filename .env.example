DB_URL=jdbc:postgresql://localhost:5432/footballxtreme
DB_USERNAME=footballxtreme
DB_PASSWORD=replace-with-a-unique-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
