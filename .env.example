DB_URL=jdbc:postgresql://localhost:5432/footballxtreme
DB_USERNAME=footballxtreme
DB_PASSWORD=replace-with-a-unique-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
# Optional for a visual demo; required for live transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# For local HTTP only; use true behind production HTTPS.
COOKIE_SECURE=false
# Flyway owns schema changes; keep Hibernate in validation mode.
DDL_AUTO=validate
# Populate an empty database with clearly labelled sample pitches and opening hours.
# Keep this false for any real venue.
DEMO_DATA_ENABLED=true
